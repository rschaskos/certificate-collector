{
  "version": "4.0",
  "urls": {
    "fgts": "https://consulta-crf.caixa.gov.br/consultacrf/pages/consultaEmpregador.jsf",
    "estadual": "https://cdwfazenda.paas.pr.gov.br/cdwportal/certidao/automatica",
    "federal": "https://solucoes.receita.fazenda.gov.br/Servicos/certidaointernet/PJ/Consultar",
    "trabalhista": "https://www.tst.jus.br/certidao1",
    "trabalhista_direct": "https://cndt-certidao.tst.jus.br/gerarCertidao.faces",
    "simples": "https://www8.receita.fazenda.gov.br/simplesnacional/aplicacoes.aspx?id=21",
    "tce": "https://www1.tce.pr.gov.br/conteudo/consultar-certidao-liberatoria/235540/area/54"
  },
  "selectors": {
    "fgts": {
      "cnpj_input": "[id='mainForm:txtInscricao1']",
      "submit_button": "role=button[name='Consultar']",
      "error_message": "#mainForm > div.ui-messages-error",
      "razao_social": "#mainForm > div:nth-of-type(3) > p > span:nth-of-type(2)",
      "checkbox": "[id='mainForm:j_id51']",
      "visualizar_button": "[id='mainForm:btnVisualizar']",
      "print_button": "[id='mainForm:btImprimir4']"
    },
    "estadual": {
      "cnpj_input": "role=textbox[name='CPF ou CNPJ do requerente']",
      "submit_button": "button:has-text('EMITIR CERTIDÃO')",
      "modal_table": "table tbody tr",
      "download_button": "i:has-text('file_save')"
    },
    "federal": {
      "cnpj_input": "input[name='ni']",
      "data_inicio_input": "input[name='dtInicio']",
      "data_fim_input": "input[name='dtFim']",
      "emitir_button": "button[type='submit']",
      "download_link": "a[href*='certidao']"
    },
    "trabalhista": {
      "cnpj_input": "[id='gerarCertidaoForm:cpfCnpj']",
      "captcha_input": "#idCampoResposta",
      "submit_button": "[id='gerarCertidaoForm:btnEmitirCertidao']",
      "error_message": "#mensagens li",
      "success_indicator": "embed[type='application/pdf']"
    },
    "simples": {
      "cnpj_input": "input[name='txtCNPJ']",
      "consultar_button": "input[value='Consultar']",
      "imprimir_button": "input[value='Imprimir']"
    },
    "tce": {
      "cnpj_input": "input[id*='cnpj']",
      "consultar_button": "input[type='submit'][value*='Consultar']",
      "emitir_button": "input[type='button'][value*='Emitir']"
    }
  },
  "timeouts": {
    "default_wait": 30000,
    "download_wait": 30000,
    "captcha_wait": 120000,
    "page_load": 30000
  },
  "paths": {
    "downloads": "./downloads",
    "logs": "./logs"
  },
  "settings": {
    "max_captcha_retries": 3,
    "browser_headless": false,
    "browser_timeout": 60000,
    "log_level": "INFO"
  }
}
